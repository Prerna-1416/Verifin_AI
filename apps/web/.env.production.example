# ---- VeriFin AI web app (Next.js on Vercel) ----
# Copy to your Vercel project environment settings (not committed).

# MongoDB Atlas connection string (Prisma needs a replica set — M0/M2/M5 free/paid Atlas clusters work).
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/verifin_ai?retryWrites=true&w=majority"

# Auth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="https://verifin-ai.vercel.app"
JWT_SECRET="another-long-random-string-32-chars-min"

# Backend API (Render) — used by Next.js rewrites at build/runtime.
API_URL="https://verifin-ai-api.onrender.com"
# Browser-side base URL (must stay /api/backend so the Next.js server proxies it).
NEXT_PUBLIC_API_URL="/api/backend"

# AI Service (Render)
AI_SERVICE_URL="https://verifin-ai-service.onrender.com"
# Must match AI_SERVICE_API_KEY set on the Render AI service.
AI_SERVICE_API_KEY="verifin-ai-service-key"

# Agentic threat-hunter: shared secret with the AI service agents.
AGENT_INTERNAL_KEY="verifin-agent-internal-key"

# Email (optional — regulator alerts via Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@verifin.ai"
REGULATOR_EMAIL="notifications@verifin.ai"

# WhatsApp Bot (optional)
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# File Storage (optional — only if using Vercel Blob / S3)
BLOB_READ_WRITE_TOKEN=""

# Redis (optional — for queues)
REDIS_URL=""
