# ---- VeriFin AI backend API (FastAPI on Render) ----

# MongoDB Atlas connection string (or same as web's DATABASE_URL).
MONGO_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
DATABASE_NAME="verifin_ai"

# Security
JWT_SECRET="a-long-random-secret-32-chars-min"
JWT_ALGORITHM="HS256"

# AI service (Render) + shared key (must match the AI service env).
AI_SERVICE_URL="https://verifin-ai-service.onrender.com"
AI_SERVICE_API_KEY="verifin-ai-service-key"

# CORS — JSON array of allowed browser origins (your Vercel app URL).
CORS_ORIGINS=["https://verifin-ai.vercel.app"]

# Optional Redis for queues.
REDIS_URL=""
