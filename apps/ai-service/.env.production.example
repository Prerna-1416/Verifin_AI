# ---- VeriFin AI detection service (FastAPI on Render) ----

# Shared key: web app proxies send this as X-Api-Key / AI_SERVICE_API_KEY.
AI_SERVICE_API_KEY="verifin-ai-service-key"

# The Next.js app URL (agents publish findings to its internal endpoint).
WEB_URL="https://verifin-ai.vercel.app"

# Shared secret the web app accepts on /api/internal/agents/publish.
AGENT_INTERNAL_KEY="verifin-agent-internal-key"

# Autonomy
AGENT_ENABLED="true"
AGENT_DEMO="true"
AGENT_INTERVAL_SECONDS="600"

# WhatsApp Bot (optional)
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
