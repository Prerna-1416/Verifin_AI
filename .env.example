# Database (run a local mongod on port 27018; a plain standalone is fine)
DATABASE_URL="mongodb://localhost:27018/verifin_ai"

# Auth
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="your-jwt-secret-key-min-32-chars-change-in-production"

# API
API_URL="http://localhost:8000"
# Browser-side base URL. The Next.js server rewrites /api/backend/* -> API_URL.
NEXT_PUBLIC_API_URL="/api/backend"

# AI Service
AI_SERVICE_URL="http://localhost:8001"
# Must match the AI service's expected key (API_KEY in apps/ai-service/app/main.py).
# The web proxy routes read this; if unset they fall back to "verifin-ai-service-key".
AI_SERVICE_API_KEY="verifin-ai-service-key"

# File Storage (AWS S3 / Vercel Blob)
BLOB_READ_WRITE_TOKEN="vercel-blob-token"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# Email (Resend / SendGrid)
RESEND_API_KEY=""
EMAIL_FROM="noreply@verifin.ai"
REGULATOR_EMAIL="notifications@verifin.ai"

# Agentic threat-hunter (shared key between ai-service agents and the web publish API)
AGENT_INTERNAL_KEY="verifin-agent-internal-key"

# WhatsApp Bot (optional — enables live webhook replies via WhatsApp Business Cloud API)
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# External APIs (Optional)
VIRUSTOTAL_API_KEY=""
GOOGLE_SAFE_BROWSING_API_KEY=""
ABUSEIPDB_API_KEY=""

# Redis (for queues)
REDIS_URL="redis://localhost:6379"

# Monitoring (Optional)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Feature Flags
NEXT_PUBLIC_ENABLE_AUDIO="true"
NEXT_PUBLIC_ENABLE_IMAGE="true"
NEXT_PUBLIC_ENABLE_EXTENSION="true"