# Database
DATABASE_URL="mongodb://localhost:27017/verifin_ai?replicaSet=rs0"

# Auth
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="your-jwt-secret-key-min-32-chars-change-in-production"

# API
API_URL="http://localhost:8000"
NEXT_PUBLIC_API_URL="http://localhost:8000"

# AI Service
AI_SERVICE_URL="http://localhost:8001"
AI_SERVICE_API_KEY="your-ai-service-api-key"

# File Storage (AWS S3 / Vercel Blob)
BLOB_READ_WRITE_TOKEN="vercel-blob-token"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# Email (Resend / SendGrid)
RESEND_API_KEY=""
EMAIL_FROM="noreply@verifin.ai"

# External APIs (Optional)
VIRUSTOTAL_API_KEY=""
GOOGLE_SAFE_BROWSING_API_KEY=""
ABUSEIPDB_API_KEY=""

# Redis (for queues)
REDIS_URL="redis://localhost:6379"

# Monitoring (Optional)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Feature Flags
NEXT_PUBLIC_ENABLE_AUDIO="true"
NEXT_PUBLIC_ENABLE_IMAGE="true"
NEXT_PUBLIC_ENABLE_EXTENSION="true"